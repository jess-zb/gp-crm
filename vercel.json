{
  "buildCommand": "npm run vercel-build",
  "functions": {
    "app/api/sign/pdf/route.ts": {
      "includeFiles": "public/esign-templates/**"
    },
    "app/api/sign/complete/route.ts": {
      "includeFiles": "public/esign-templates/**"
    },
    "app/api/esign/template-pdf/route.ts": {
      "includeFiles": "public/esign-templates/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/dispatch-emails",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/missed-appointments",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/holiday-autoresponder",
      "schedule": "0 * * * *"
    }
  ]
}
