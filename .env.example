# Database API — project URL + anon public key (from your provider dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres URI (Settings → Database) — for scripts like `pnpm import-sql-batches` only; never expose to the browser
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# App URL — local: http://localhost:3000. Production must be https://dspcrm.vercel.app
# (fallback DEFAULT_APP_URL). Do not use app.debtsupportpros.com; that host has no DNS.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Client portal — "Teach Me" sidebar link (opens in a new tab; e.g. Scribe workspace URL)
# NEXT_PUBLIC_SCRIBE_WORKSPACE_URL=

# Print partner FedEx intake (GET /intake?action=batch — bearer + API key)
POSTLOGIC_API_URL=https://mgapepreyainffkvezjc.supabase.co/functions/v1/intake
POSTLOGIC_BEARER=
POSTLOGIC_API_KEY=PL-PORTAL-2026-ZB
# POSTLOGIC_X_API_KEY=PL-PORTAL-2026-ZB

# PostLogic → CRM webhook (tracking / Print ID push; implement app/api/webhooks/postlogic/route.ts)
# POSTLOGIC_WEBHOOK_SECRET=

# Vercel Cron: set on the project; Vercel sends Authorization: Bearer <CRON_SECRET> (see Vercel Cron docs)
CRON_SECRET=

# POST to notify attorney when a collection letter is uploaded or retried (JSON body: { documentId, clientId })
# ATTORNEY_NOTIFY_WEBHOOK_URL=

# HERE Maps — address autocomplete (JavaScript API key; https://developer.here.com)
# NEXT_PUBLIC_HERE_KEY=

# Native eSign (Packets tab). Send UI is Dev plus named pilots in
# lib/esign/config.ts ESIGN_PILOT_EMAILS. Place fields stays Dev.
# Unset = on; set false to disable.
# ESIGN_ENABLED=false
# OPENSIGN_ESIGN_ENABLED=false
# OPENSIGN_API_BASE=https://sandbox.opensignlabs.com/api/v1.2
# OPENSIGN_API_TOKEN=
# OPENSIGN_WEBHOOK_SECRET=
# OPENSIGN_TEMPLATE_CC_AUTH=
# OPENSIGN_TEMPLATE_WELCOME_PACKET=

# Optional integrations (add when you connect each service)
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_SECRET_KEY=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_TEMPLATE_ID=
# DOCUSIGN_ACCESS_TOKEN=

# RingCentral — Credentials → Create JWT (paste into RINGCENTRAL_JWT_TOKEN; set in production env)
# RINGCENTRAL_CLIENT_ID=
# RINGCENTRAL_CLIENT_SECRET=
# RINGCENTRAL_JWT_TOKEN=
# RINGCENTRAL_WEBHOOK_SECRET=
# RINGCENTRAL_PHONE_NUMBER=
# FEDEX_API_KEY=

# ElevenLabs — Teach Me guide narration (optional; falls back to browser speech if unset)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Anthropic — used by Trigger.dev tasks (e.g. diagnose-bug); also add in Trigger.dev dashboard under Environment Variables
ANTHROPIC_API_KEY=

# CRM CSV / clipboard exports (Clients, Reports, Packet Manager, bulk-invite).
# Unset = off. Set true to restore the previous role gates.
# CRM_CSV_EXPORT_ENABLED=true
# CLIENT_CSV_EXPORT_ENABLED=true
