# Supabase — project URL + anon public key (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres URI (Project Settings → Database) — used by `pnpm migrate`
# and the SQL batch scripts only. Never expose to the browser.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# App URL — local override. When both are unset, client links use
# DEFAULT_APP_URL (https://goldenpathway.vercel.app).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=

# Email (Resend) — API key plus the signing secret for the delivery webhook
RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=

# Vercel Cron: set on the project; Vercel sends Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Partner lead intake. POST /api/leads with Authorization: Bearer <LEADS_API_KEY>
# or X-Api-Key. Generate a long random value. Never commit it.
# Unset = the route refuses every request.
LEADS_API_KEY=

# POST to notify the attorney when a collection letter is uploaded or retried
# (JSON body: { documentId, clientId })

# HERE Maps address autocomplete on client create and edit.
# Set NEXT_PUBLIC_HERE_KEY in .env.local, then restart the dev server.
# NEXT_PUBLIC_HERE_KEY=

# E-Sign (client profile → Packets → E-Sign). Unset = on; set false to disable.
# ESIGN_ENABLED=false

# Holiday autoresponder timezone (IANA name; defaults to America/Los_Angeles)
# HOLIDAY_TIMEZONE=

# CRM CSV / clipboard exports (Clients, Reports, bulk-invite).
# Unset = off, which is the intended default. Set true to enable.
# CRM_CSV_EXPORT_ENABLED=true
